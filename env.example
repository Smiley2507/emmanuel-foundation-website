# Sanity Configuration
# Get these values from https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional: For preview/draft content
# SANITY_API_READ_TOKEN=your_read_token_here

# Stripe Payment Configuration
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# MTN MoMo Pay Configuration (Collections API)
# Register at https://momodeveloper.mtn.com and subscribe to Collections product
MOMO_COLLECTION_SUBSCRIPTION_KEY=your_momo_subscription_key
MOMO_API_USER_ID=your_momo_api_user_id
MOMO_API_KEY=your_momo_api_key
MOMO_ENVIRONMENT=sandbox
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_CURRENCY=EUR
MOMO_CALLBACK_URL=https://your-domain.com/api/momo/callback
